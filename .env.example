SITE_BASE_URL=http://localhost:3000
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
ADMIN_PASSWORD_SALT=polariss-dev-salt
NEXT_PUBLIC_BUY_NOW_URL=https://polariss-store.myshopify.com/
NEXT_PUBLIC_PARTNER_URL=https://polariss-store.myshopify.com/products/%E6%AF%8E%E6%9C%88%E9%80%9A%E4%BF%A1%E8%B2%BB
NEXT_PUBLIC_ORIGINAL_SITE_URL=https://thingsline.co.jp/index
NEXT_PUBLIC_CK_EDITOR_LICENCE_KEY=your-licence-key

# --- Database (local by default) ---
# Local SQLite file at data/polariss.sqlite is used when no Turso URL is set.
# To use a remote DB (e.g. Turso) on ephemeral deployments, set:
# DB_PROVIDER=turso
# TURSO_DATABASE_URL=libsql://your-db-xxx.turso.io
# TURSO_AUTH_TOKEN=your_turso_token
# Alternative names also supported: DATABASE_URL, TURSO_DB_URL, DATABASE_AUTH_TOKEN
# It is important to setup Turso database and auth token in local development first , 
# verify the connection works , and then set the DB url and DB token later on vercel
DB_PROVIDER=local
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# --- Article keywords ---
# Max keywords allowed per article in the admin editor (baseline is 25).
NEXT_PUBLIC_ARTICLE_KEYWORDS_MAX=25
# Max keywords shown on the public article page (fewer avoids visual clutter).
NEXT_PUBLIC_ARTICLE_KEYWORDS_PUBLIC_MAX=5

# --- Article image storage ---
# false: store uploads locally in public/articles-assets (recommended for local development)
# true: store uploads permanently in Vercel Blob (requires BLOB_READ_WRITE_TOKEN)
BLOB_STORAGE_ENABLED=false
BLOB_READ_WRITE_TOKEN=
